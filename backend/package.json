{
  "name": "amader-barir-pujo-backend",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "description": "Backend API for Amader Barir Pujo",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:tunnel": "ts-node scripts/dev-tunnel.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "async-mutex": "^0.4.0",
    "axios": "^1.6.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "nodemailer": "^6.9.7",
    "qrcode-terminal": "^0.12.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1",
    "whatsapp-web.js": "^1.34.7",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "ngrok": "^4.3.3",
    "prettier": "^3.1.1"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true
  }
}
